-- vim: set ft=sql

import 'tables.dart';

CREATE VIRTUAL TABLE sauce_fts USING fts5(
  title,
  description,
  content='sauce_items',
  content_rowid='id',
  tokenize='unicode61 remove_diacritics 2'
);

-- Triggers to keep fts index in sync
CREATE TRIGGER sauce_ai AFTER INSERT ON sauce_items BEGIN
  INSERT INTO sauce_fts(rowid, title, description)
  VALUES (new.id, new.title, new.description);
END;

CREATE TRIGGER sauce_ad AFTER DELETE ON sauce_items BEGIN
  INSERT INTO sauce_fts(sauce_fts, rowid, title, description)
  VALUES ('delete', old.id, old.title, old.description);
END;

CREATE TRIGGER sauce_au AFTER UPDATE ON sauce_items BEGIN
  INSERT INTO sauce_fts(sauce_fts, rowid, title, description)
  VALUES ('delete', old.id, old.title, old.description);

  INSERT INTO sauce_fts(rowid, title, description)
  VALUES (new.id, new.title, new.description);
END;

-- Example
_allSauceItemsWithTags:
SELECT
  si.*,
  COALESCE(GROUP_CONCAT(t.name, ','), '') AS tags_str
FROM
  sauce_items si
  LEFT OUTER JOIN sauce_tags st ON si.id = st.sauce_id
  LEFT OUTER JOIN tags t ON st.tag_id = t.id
GROUP BY si.id;
